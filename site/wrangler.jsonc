{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "studiegroep",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "studiegroep",
      "database_id": "0ccc5569-3e8f-462d-a48b-05a7a82b09d7",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "studiegroep-photos", "jurisdiction": "eu" }
  ],
  "vars": {
    "SITE_URL": "https://studiegroep.eu",
    "MAIL_FROM": "EU Studiegroep <aanmelden@studiegroep.eu>",
    "MAIL_REPLY_TO": "eustudiegroep@gmail.com",
    // Cloudflare Access (Zero Trust > Access > Applications > studiegroep admin)
    "ACCESS_TEAM_DOMAIN": "https://REPLACE-ME.cloudflareaccess.com",
    "ACCESS_AUD": "568797a1066b4428833df849ad14737b217c5025e3086f0bf6ec5beccd8f2f28",
    // Turnstile site key (public); the secret goes in TURNSTILE_SECRET_KEY
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFi0ijw22a4SQnFi"
  }
  // Secrets (wrangler secret put ...): RESEND_API_KEY, TURNSTILE_SECRET_KEY, CALENDAR_FEED_TOKEN
}
