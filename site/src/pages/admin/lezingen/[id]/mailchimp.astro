---
import { env } from "cloudflare:workers";
import Admin from "../../../../layouts/Admin.astro";
import { getLecture } from "../../../../lib/db";
import { lectureTitle, longDate, mapsUrl, imageUrl } from "../../../../lib/format";
import { esc } from "../../../../lib/html";

const lecture = await getLecture(Number(Astro.params.id));
if (!lecture) return new Response(null, { status: 404 });

const link = `${env.SITE_URL}/lezingen/${lecture.slug}#aanmelden`;
const photo = imageUrl(lecture);
const photoUrl = photo && !photo.startsWith("http") ? `${env.SITE_URL}${photo}` : photo;

// Same newsletter block the old organiser page generated, now pointing at the lecture page.
const html = `<div style="font-family: Arial, sans-serif; color: #333333; line-height: 1.5; max-width: 600px; margin: 0 auto;">
  <h1 style="color: #0E3A73; margin-bottom: 5px;">🇪🇺 ${esc(lectureTitle(lecture.date))}</h1>
  <h2 style="margin-top: 0;">${esc(lecture.speaker_name)}</h2>
  <p style="font-style: italic; color: #666;">${esc(lecture.speaker_role)}</p>
  ${photoUrl ? `<img src="${esc(photoUrl)}" alt="${esc(lecture.speaker_name)}" style="width: 100%; max-width: 600px; border-radius: 8px; margin: 15px 0;" />` : ""}
  <p>${esc(lecture.speaker_bio).replace(/\n/g, "<br>")}</p>
  <hr style="border: 0; border-top: 1px solid #eeeeee; margin: 25px 0;">
  <h3 style="margin-bottom: 5px;">📅 ${esc(longDate(lecture.date))}</h3>
  ${lecture.time_dinner && lecture.dinner_name ? `<div style="margin-bottom: 15px; border: 1px solid #eee; border-left: 4px solid #ff9800; padding: 15px; border-radius: 4px; background-color: #fff8e1;">
    <p style="margin: 0; font-weight: bold; font-size: 1.1em; margin-bottom: 5px;">🍕 Diner</p>
    <p style="margin: 0 0 5px 0;"><strong>🕕 ${esc(lecture.time_dinner)}</strong> (aanvang)</p>
    <p style="margin: 0;">📍 <strong>${esc(lecture.dinner_name)}</strong> (${esc(lecture.dinner_address)} · <a href="${esc(mapsUrl(lecture.dinner_maps_url, lecture.dinner_name, lecture.dinner_address))}" style="color: #ff9800; text-decoration: none;">Route</a>)</p>
  </div>` : ""}
  <div style="margin-bottom: 25px; border: 1px solid #eee; border-left: 4px solid #4caf50; padding: 15px; border-radius: 4px; background-color: #e8f5e9;">
    <p style="margin: 0; font-weight: bold; font-size: 1.1em; margin-bottom: 5px;">🎤 Lezing</p>
    <p style="margin: 0 0 5px 0;"><strong>🕢 ${esc(lecture.time_lecture)}</strong> (aanvang)</p>
    <p style="margin: 0;">📍 <strong>${esc(lecture.lecture_name)}</strong> (${esc(lecture.lecture_address)} · <a href="${esc(mapsUrl(lecture.lecture_maps_url, lecture.lecture_name, lecture.lecture_address))}" style="color: #4caf50; text-decoration: none;">Route</a>)</p>
  </div>
  <div style="text-align: center; margin: 30px 0;">
    <a href="${esc(link)}" style="background-color: #28a745; color: #ffffff; padding: 15px 25px; text-decoration: none; border-radius: 5px; font-weight: bold; font-size: 18px; display: inline-block;">👉 Meld je hier aan</a>
  </div>
</div>`;
---

<Admin title="Mailchimp-HTML">
  <h1>Nieuwsbrief / uitnodiging</h1>
  <p>Kopieer deze code in een Mailchimp-blok van het type "Code". <a href={`/admin/lezingen/${lecture.id}`}>Terug naar de lezing</a></p>
  <textarea readonly rows="16" onclick="this.select()">{html}</textarea>
  <h2>Voorbeeld</h2>
  <div class="card" set:html={html} />
</Admin>
