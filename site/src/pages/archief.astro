---
import Base from "../layouts/Base.astro";
import LectureCard from "../components/LectureCard.astro";
import { getPastLectures } from "../lib/db";

const past = await getPastLectures();
---

<Base title="Archief · EU Studiegroep">
  <div class="page-head" slot="hero">
    <p class="eyebrow">Archief</p>
    <h1>Eerdere avonden</h1>
  </div>
  <div class="container narrow" style="padding: 0">
    {past.length === 0 ? <p class="notice">Nog geen eerdere lezingen.</p> : past.map((lecture) => <LectureCard lecture={lecture} />)}
  </div>
</Base>
