---
import type { Lecture } from "../lib/db";

interface Props {
  lecture: Lecture;
  /** Show a signup button (upcoming lectures with signup open). */
  signup?: boolean;
}

const { lecture, signup = false } = Astro.props;
const date = new Date(`${lecture.date}T12:00:00Z`);
const day = date.getUTCDate();
const month = new Intl.DateTimeFormat("nl-NL", { month: "short", year: "numeric", timeZone: "UTC" }).format(date).replace(".", "");
---

<article class="card">
  <div class="day"><strong>{day}</strong><span>{month}</span></div>
  <div>
    <h3><a href={`/lezingen/${lecture.slug}`}>{lecture.speaker_name}</a></h3>
    {lecture.speaker_role && <p class="meta">{lecture.speaker_role}</p>}
  </div>
  {signup && Boolean(lecture.signup_open) && <a class="button secondary" href={`/lezingen/${lecture.slug}#aanmelden`}>Aanmelden</a>}
</article>
