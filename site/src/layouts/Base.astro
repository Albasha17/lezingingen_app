---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/plus-jakarta-sans";
import "../styles/global.css";
import Skyline from "../components/Skyline.astro";

interface Props {
  title: string;
  description?: string;
  /** Taller sky with room for a large hero (homepage). */
  tall?: boolean;
}

const {
  title,
  description = "EU Studiegroep: elke maand een lezing over een actueel thema met een Europese invalshoek, in Amsterdam.",
  tall = false,
} = Astro.props;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1a36" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class:list={["sky", { tall }]}>
      <Skyline />
      <div class="container">
        <header class="site">
          <div class="bar glass">
            <a class="brand" href="/">
              <svg width="26" height="26" viewBox="0 0 64 64" aria-hidden="true"><g fill="#ffcc00"><circle cx="32" cy="6" r="4.5" /><circle cx="45" cy="9.5" r="4.5" /><circle cx="54.5" cy="19" r="4.5" /><circle cx="58" cy="32" r="4.5" /><circle cx="54.5" cy="45" r="4.5" /><circle cx="45" cy="54.5" r="4.5" /><circle cx="32" cy="58" r="4.5" /><circle cx="19" cy="54.5" r="4.5" /><circle cx="9.5" cy="45" r="4.5" /><circle cx="6" cy="32" r="4.5" /><circle cx="9.5" cy="19" r="4.5" /><circle cx="19" cy="9.5" r="4.5" /></g></svg>
              EU Studiegroep
            </a>
            <nav aria-label="Hoofdmenu">
              <a href="/#programma">Programma</a>
              <a href="/#over">Over ons</a>
              <a href="/archief">Archief</a>
            </nav>
            <a class="button cta" href="/#aanmelden">Aanmelden</a>
          </div>
        </header>
        <slot name="hero" />
      </div>
    </div>
    <main>
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="container">
        <span class="mark">
          <svg width="54" height="16" viewBox="0 0 54 16" aria-hidden="true"><g stroke="#ffc36b" stroke-width="3" stroke-linecap="round"><path d="M2 2 L14 14 M14 2 L2 14" /><path d="M21 2 L33 14 M33 2 L21 14" /><path d="M40 2 L52 14 M52 2 L40 14" /></g></svg>
          EU Studiegroep · Amsterdam
        </span>
        <nav aria-label="Voettekst">
          <a href="/#contact">Contact</a>
          <a href="/archief">Archief</a>
          <a href="/admin">Beheer</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
