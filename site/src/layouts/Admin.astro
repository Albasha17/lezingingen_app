---
import "@fontsource-variable/fraunces";
import "@fontsource-variable/plus-jakarta-sans";
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
const admin = Astro.locals.admin!;
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} · Beheer EU Studiegroep</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="admin">
    <header class="site">
      <div class="container wide">
        <a class="brand" href="/admin">EU Studiegroep <span class="tag">Beheer</span></a>
        <nav>
          <a href="/admin">Lezingen</a>
          <a href="/admin/lezingen/nieuw">Nieuwe lezing</a>
          {admin.role === "owner" && <a href="/admin/beheerders">Beheerders</a>}
          <a href="/admin/instellingen">Instellingen</a>
          <a href="/">Website bekijken</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="container wide">
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="container wide">Ingelogd als {admin.email} · <a href="/cdn-cgi/access/logout">Uitloggen</a></div>
    </footer>
  </body>
</html>
